{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging.HttpLoggingMiddleware": "Information",
      "Coffeehouse.Api": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=CoffeehouseDb;Trusted_Connection=True;TrustServerCertificate=True;",
    "Coffeehouse": "Server=(localdb)\\MSSQLLocalDB;Database=CoffeehouseDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "DataSource": {
    "Provider": "Json",
    "JsonFilePath": "Data/CandidateProfiles.json"
  },
  "Authentication": {
    "Enabled": true,
    "Issuer": "CoffeehouseTeachingApi",
    "Audience": "CoffeehouseStudents",
    "AccessTokenMinutes": 60
  }
}
