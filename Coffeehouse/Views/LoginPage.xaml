<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Coffeehouse.ViewModels"
             x:Class="Coffeehouse.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Log In">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">
            
            <Label Text="Sign In"
                   FontSize="28"
                   FontAttributes="Bold"
                   HorizontalOptions="Center" />

            <Label Text="Sign in to create, update, or remove candidate profiles."
                   FontSize="14"
                   TextColor="Gray"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center" />

            <!-- Banner Message from redirect -->
            <Border BackgroundColor="#E8F0FE"
                    Stroke="#4285F4"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    IsVisible="{Binding HasMessage}">
                <Label Text="{Binding Message}"
                       TextColor="#1967D2"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </Border>

            <!-- Error Banner -->
            <Border BackgroundColor="#FCE8E6"
                    Stroke="#D93025"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#D93025"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </Border>

            <!-- Username Field -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Username" FontAttributes="Bold" FontSize="14" />
                <Entry Text="{Binding Username}"
                       Placeholder="Enter username"
                       ReturnType="Next" />
            </VerticalStackLayout>

            <!-- Password Field -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Password" FontAttributes="Bold" FontSize="14" />
                <Entry Text="{Binding Password}"
                       Placeholder="Enter password"
                       IsPassword="True"
                       ReturnType="Done" />
            </VerticalStackLayout>

            <!-- Login Button -->
            <Button Text="Log In"
                    Command="{Binding LoginCommand}"
                    Margin="0,10,0,0"
                    HeightRequest="50"
                    FontSize="16"
                    FontAttributes="Bold"
                    IsEnabled="{Binding IsNotBusy}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
