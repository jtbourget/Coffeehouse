<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Coffeehouse.ViewModels"
             x:Class="Coffeehouse.Views.AddressPage">
    <ScrollView>
        <VerticalStackLayout Padding="25" Spacing="20" VerticalOptions="Start" Margin="0,20,0,0">
            
            <Label Text="Where are you registered?" 
                   FontSize="26" 
                   FontAttributes="Bold" 
                   HorizontalTextAlignment="Center" />

            <Label Text="Enter your address to load your localized ballot." 
                   FontSize="14" 
                   TextColor="Gray" 
                   HorizontalTextAlignment="Center" 
                   Margin="0,-10,0,15" />

            <Border StrokeShape="RoundRectangle 10" Stroke="{AppThemeBinding Light=#ccc, Dark=#444}" BackgroundColor="{AppThemeBinding Light=White, Dark=#222}" Padding="5">
                <SearchBar Text="{Binding SearchText}" Placeholder="Type your street address..." BackgroundColor="Transparent" />
            </Border>

            <CollectionView ItemsSource="{Binding Suggestions}" MaximumHeightRequest="200">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="15">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:AddressViewModel}}, Path=SelectSuggestionCommand}" CommandParameter="{Binding .}" />
                            </Grid.GestureRecognizers>
                            <Label Text="{Binding Description}" FontSize="16" />
                            <BoxView HeightRequest="1" BackgroundColor="{AppThemeBinding Light=#eee, Dark=#333}" VerticalOptions="End" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Border IsVisible="{Binding HasAddress}" StrokeShape="RoundRectangle 10" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light={StaticResource Secondary}, Dark={StaticResource Tertiary}}" Padding="20">
                <VerticalStackLayout Spacing="5">
                    <Label Text="📍 Selected Address" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark=#E8DCCA}" FontSize="14" Margin="0,0,0,5" />
                    <Label Text="{Binding Street}" FontSize="18" FontAttributes="Bold" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                    <Label Text="{Binding City}" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                    <Label Text="{Binding State}" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                    <Label Text="{Binding ZipCode}" FontSize="16" TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                </VerticalStackLayout>
            </Border>

            <Button Text="View My Ballot" 
                    Command="{Binding FindBallotCommand}" 
                    BackgroundColor="{StaticResource Primary}"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    CornerRadius="10"
                    Padding="15"
                    Margin="0,15,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
