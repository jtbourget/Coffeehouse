<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Coffeehouse.ViewModels"
             xmlns:models="clr-namespace:Coffeehouse.Models"
             x:Class="Coffeehouse.Views.BallotPage"
             Title="Your Ballot">

    <Grid Padding="0">
        
        <!-- Contests and Candidates -->
        <CollectionView ItemsSource="{Binding Contests}">
            
            <CollectionView.Header>
                <Border BackgroundColor="{StaticResource Primary}" StrokeThickness="0" Padding="15,20,15,15" Margin="0,0,0,10">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="Your Official Ballot" FontSize="12" TextColor="{StaticResource Secondary}" FontAttributes="Bold" TextTransform="Uppercase" />
                        <Label Text="{Binding CurrentElection.Name}" FontSize="20" FontAttributes="Bold" TextColor="White" />
                        <Label Text="{Binding CurrentElection.ElectionDate, StringFormat='{0:MMMM dd, yyyy}'}" FontSize="14" TextColor="White" />
                        <Label Text="{Binding CurrentElection.VotingLocationName}" FontSize="12" TextColor="{StaticResource Secondary}" />
                    </VerticalStackLayout>
                </Border>
            </CollectionView.Header>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ContestDisplay">
                    <VerticalStackLayout Margin="0,10,0,20">
                        
                        <!-- Office Header -->
                        <Grid ColumnDefinitions="4, *" Padding="20,0">
                            <BoxView Grid.Column="0" Color="{StaticResource Primary}" CornerRadius="2" />
                            <Label Grid.Column="1" Text="{Binding OfficeName}" FontSize="18" FontAttributes="Bold" Padding="10,0,0,0" VerticalOptions="Center" />
                        </Grid>
                        
                        <!-- Candidates Carousel -->
                        <CollectionView ItemsSource="{Binding}" ItemsLayout="HorizontalList" HeightRequest="215" Margin="0,10,0,0" HorizontalScrollBarVisibility="Never">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:CandidateDisplay">
                                    <Border StrokeShape="RoundRectangle 12" StrokeThickness="1" Stroke="{AppThemeBinding Light=#ddd, Dark=#444}" BackgroundColor="{AppThemeBinding Light=White, Dark=#1e1e1e}" Margin="20,0,0,15" WidthRequest="140" Padding="15">
                                        <!-- Add a subtle shadow -->
                                        <Border.Shadow>
                                            <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.05" />
                                        </Border.Shadow>

                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BallotViewModel}}, Path=ViewCandidateCommand}" CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                                            
                                            <Button Text="{Binding FavoriteIcon}" 
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:BallotViewModel}}, Path=ToggleFavoriteCommand}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="Transparent" 
                                                    TextColor="{StaticResource Primary}" 
                                                    FontSize="28"
                                                    Padding="0" Margin="0,-15,0,0"
                                                    HeightRequest="30" HorizontalOptions="Center" />

                                            <Border StrokeShape="RoundRectangle 35" WidthRequest="70" HeightRequest="70" HorizontalOptions="Center" Margin="0,-5,0,5">
                                                <Image Source="{Binding PhotoUrl}" Aspect="AspectFill" />
                                            </Border>
                                            
                                            <Label Text="{Binding Candidate.Name}" FontSize="14" FontAttributes="Bold" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                                            <Label Text="{Binding Candidate.Party}" FontSize="12" TextColor="Gray" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center" />
                                            
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

    </Grid>
</ContentPage>
