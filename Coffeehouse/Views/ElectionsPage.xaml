<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Coffeehouse.ViewModels"
             xmlns:models="clr-namespace:Coffeehouse.Models"
             x:Class="Coffeehouse.Views.ElectionsPage"
             Title="Upcoming Elections">

    <Grid RowDefinitions="Auto,*" Padding="0" BackgroundColor="{AppThemeBinding Light=#f9f9f9, Dark=#1a1a1a}">
        
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="25,30,25,20" Spacing="5">
            <Label Text="Your Upcoming Elections" FontSize="26" FontAttributes="Bold" />
            <Label Text="Tap an election to view your localized ballot and candidates." FontSize="14" TextColor="Gray" />
        </VerticalStackLayout>

        <!-- Elections List -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Elections}" SelectionMode="None" Margin="15,0,15,0">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Election">
                    <Border Margin="5,5,5,15" Padding="20"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light=White, Dark=#2c2c2c}">
                        
                        <Border.Shadow>
                            <Shadow Brush="Black" Offset="0,4" Radius="10" Opacity="0.08" />
                        </Border.Shadow>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ElectionsViewModel}}, Path=SelectElectionCommand}" 
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        
                        <Grid ColumnDefinitions="*, Auto">
                            <VerticalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" TextColor="{StaticResource Primary}" />
                                <Label Text="{Binding ElectionDate, StringFormat='{0:MMMM dd, yyyy}'}" FontSize="14" TextColor="{AppThemeBinding Light=Black, Dark=White}" />
                                <Label Text="{Binding VotingLocationName}" FontSize="13" TextColor="Gray" Margin="0,5,0,0" />
                            </VerticalStackLayout>
                            
                            <!-- Arrow Icon to indicate it's clickable -->
                            <Label Grid.Column="1" Text="➔" FontSize="20" TextColor="{StaticResource Primary}" VerticalOptions="Center" FontAttributes="Bold" Opacity="0.5" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
