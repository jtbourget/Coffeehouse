<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Coffeehouse.ViewModels"
             xmlns:models="clr-namespace:Coffeehouse.Models"
             x:Class="Coffeehouse.Views.ElectionsPage"
             Title="Upcoming Elections">

    <!-- Wrapper provides padding since CollectionView doesn't support it directly -->
    <VerticalStackLayout Padding="10">
        <CollectionView ItemsSource="{Binding Elections}" SelectionMode="None">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Election">
                    <Border Margin="0,0,0,10" Padding="15"
                            StrokeShape="RoundRectangle 8"
                            Stroke="LightGray" StrokeThickness="1">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer 
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:ElectionsViewModel}}, Path=SelectElectionCommand}" 
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <Label Text="{Binding ElectionDate, StringFormat='{0:MMMM dd, yyyy}'}" FontSize="14" TextColor="Gray" />
                            <Label Text="{Binding VotingLocationName}" FontSize="14" Margin="0,5,0,0" />
                            <Label Text="{Binding VotingLocationAddress}" FontSize="12" TextColor="Gray" />
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentPage>
