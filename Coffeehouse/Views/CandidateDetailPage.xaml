<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Coffeehouse.ViewModels"
             x:Class="Coffeehouse.Views.CandidateDetailPage"
             Title="Candidate Details">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Image Source="{Binding CurrentCandidate.PhotoUrl}" HeightRequest="200" Aspect="AspectFit" />
            
            <Label Text="{Binding CurrentCandidate.Name}" FontSize="24" FontAttributes="Bold" HorizontalOptions="Center" />
            <Label Text="{Binding CurrentCandidate.Party}" FontSize="16" TextColor="Gray" HorizontalOptions="Center" />

            <Button Text="{Binding FavoriteIcon}" Command="{Binding ToggleFavoriteCommand}" Margin="0,10" />

            <Label Text="Biography &amp; Platform" FontSize="18" FontAttributes="Bold" Margin="0,10,0,0" />
            <Label Text="{Binding CurrentCandidate.Bio}" FontSize="14" />

            <Button Text="Visit Campaign Website" Command="{Binding OpenWebsiteCommand}" Margin="0,20,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
