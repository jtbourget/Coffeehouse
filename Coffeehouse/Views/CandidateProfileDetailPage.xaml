<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:Coffeehouse.ViewModels"
             x:Class="Coffeehouse.Views.CandidateProfileDetailPage"
             x:DataType="vm:CandidateProfileDetailViewModel"
             Title="Candidate Profile">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <!-- Error Banner -->
            <Border BackgroundColor="#FCE8E6"
                    Stroke="#D93025"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    Padding="12"
                    IsVisible="{Binding HasError}">
                <Label Text="{Binding ErrorMessage}"
                       TextColor="#D93025"
                       FontSize="14"
                       HorizontalOptions="Center" />
            </Border>

            <!-- Name and Status -->
            <Label Text="{Binding Profile.Name}"
                   FontSize="26"
                   FontAttributes="Bold" />

            <!-- OCD ID / District Identifier -->
            <VerticalStackLayout Spacing="4">
                <Label Text="District (OCD-ID)" FontSize="12" TextColor="Gray" FontAttributes="Bold" />
                <Label Text="{Binding Profile.OcdId}" FontSize="15" />
            </VerticalStackLayout>

            <!-- Verification Status -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Status" FontSize="12" TextColor="Gray" FontAttributes="Bold" />
                <Label Text="{Binding Profile.FormattedStatus}"
                       FontSize="15"
                       TextColor="{AppThemeBinding Light=#1967D2, Dark=#8AB4F8}" />
            </VerticalStackLayout>

            <!-- Bio -->
            <VerticalStackLayout Spacing="4" Margin="0,8,0,0">
                <Label Text="Biography &amp; Platform" FontSize="16" FontAttributes="Bold" />
                <Label Text="{Binding Profile.Bio}" FontSize="14" LineHeight="1.3" />
            </VerticalStackLayout>

            <!-- Website Button -->
            <Button Text="Visit Campaign Website"
                    Command="{Binding OpenWebsiteCommand}"
                    Margin="0,8,0,0"
                    IsVisible="{Binding Profile.WebsiteUrl, Converter={x:Null}}" />

            <!-- Action Buttons: Edit and Delete -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,24,0,0">
                <Button Grid.Column="0"
                        Text="Edit Profile"
                        Command="{Binding EditCommand}"
                        BackgroundColor="#1967D2"
                        TextColor="White"
                        HeightRequest="48"
                        FontAttributes="Bold" />

                <Button Grid.Column="1"
                        Text="Delete Profile"
                        Command="{Binding DeleteCommand}"
                        BackgroundColor="#D93025"
                        TextColor="White"
                        HeightRequest="48"
                        FontAttributes="Bold" />
            </Grid>

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               HorizontalOptions="Center"
                               Margin="0,10,0,0" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
