<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Coffeehouse.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:Coffeehouse"
    xmlns:views="clr-namespace:Coffeehouse.Views"
    Title="Coffeehouse">

    <TabBar>
        <Tab Title="Candidates">
            <ShellContent
                Title="Candidates"
                ContentTemplate="{DataTemplate views:CandidateProfilesListPage}"
                Route="CandidateProfilesListPage" />
        </Tab>
        <Tab Title="Address" Icon="home.png">
            <ShellContent
                Title="Address"
                ContentTemplate="{DataTemplate views:AddressPage}"
                Route="AddressPage" />
        </Tab>
        <Tab Title="Voting List" Icon="ballot.png">
            <ShellContent
                Title="Voting List"
                ContentTemplate="{DataTemplate views:VotingListPage}"
                Route="VotingListPage" />
        </Tab>
    </TabBar>

</Shell>
